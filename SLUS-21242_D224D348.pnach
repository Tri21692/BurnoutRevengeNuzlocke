[Nuzlocke\Harder AI (experimental)]
author=Nuzlocke mod
description=Faster opponents: quicker cornering, a pace schedule they always run ahead of, and a higher speed cap. Experimental, see notes/ai-catchup.md.
// Corner speed: the AI drives at 0.8 of the racing line's limit (0.85 when aggressive). Now 0.9 / 0.95.
patch=1,EE,0029EE1C,word,3C013F66
patch=1,EE,0029EE20,word,34216666
patch=1,EE,0029EE30,word,3C013F73
patch=1,EE,0029EE34,word,34213333
// Far from the player, speed cap = section length / (planned section time + offset), where the offset
// (seconds ahead/behind schedule) is clamped to -4..+4. Now -6..-3: always at least 3 s per section
// quicker than planned, up to 6 s when behind schedule.
patch=1,EE,0029A138,word,3C01C0C0
patch=1,EE,0029A298,word,3C01C0C0
patch=1,EE,0029A154,word,3C01C040
patch=1,EE,0029A2B4,word,3C01C040
// Speed cap ceiling 88 m/s (197 mph, tuning value 01C913F4) -> 100 m/s (tuning value 01C91438):
// far from the player (0029A1A0, 0029A300) and near the player (0029ABE0, a flat cap).
patch=1,EE,0029A1A0,word,C4420050
patch=1,EE,0029A300,word,C4420050
patch=1,EE,0029ABE0,word,C4401438
