[Nuzlocke\Block pause-menu Retry and Quit]
author=Nuzlocke mod
description=Retry, Restart and Quit in the pause menu do nothing, so an event can't be abandoned to save a life. Resume still works.
// Pause handler 1 (around 00190800): selected item -1 = Retry (confirm "$PRRetryRace"), -2 = Quit
// ("$QUIT"). The two branches to those confirm dialogs become nops, so both fall through to the exit.
patch=1,EE,0019088C,word,00000000
patch=1,EE,0019089C,word,00000000
// Pause handler 2 (around 001910DC): jump table 004B7D70, indexed by item + 1. Quit (001911F8),
// Retry (00191110), Restart junction (00191230) and Retry (00191268) now go to the exit at 00191580.
patch=1,EE,004B7D70,word,00191580
patch=1,EE,004B7D78,word,00191580
patch=1,EE,004B7D84,word,00191580
patch=1,EE,004B7D88,word,00191580

[Nuzlocke\Harder AI\Easy]
author=Nuzlocke mod
description=Harder opponents, Easy level. Enable only one Harder AI level. Corners at 0.875 of the racing line's limit (0.925 when aggressive); far from the player, 2-5 s per section quicker than their pace schedule; catch-up from 40 m behind the player (up to +20 m/s); speed cap 100 m/s. See docs/research/ai-catchup.md.
// Corner speed factor (game: 0.8, aggressive 0.85)
patch=1,EE,0029EE1C,word,3C013F60
patch=1,EE,0029EE20,word,34210000
patch=1,EE,0029EE30,word,3C013F6C
patch=1,EE,0029EE34,word,3421CCCD
// Far-mode pace: offset to each section's planned time, clamped to -5..-2 s (game: -4..+4)
patch=1,EE,0029A138,word,3C01C0A0
patch=1,EE,0029A298,word,3C01C0A0
patch=1,EE,0029A154,word,3C01C000
patch=1,EE,0029A2B4,word,3C01C000
// Speed cap ceiling 88 -> 100 m/s (224 mph), loaded as a constant instead of tuning value 01C913F4.
// Far from the player (two copies): lui at,cap / mtc1 at,f3 / min speed via lwc1 f1,0x13F8(v0) / clamp.
patch=1,EE,0029A190,word,3C0142C8
patch=1,EE,0029A198,word,44811800
patch=1,EE,0029A19C,word,C44113F8
patch=1,EE,0029A1A0,word,46010028
