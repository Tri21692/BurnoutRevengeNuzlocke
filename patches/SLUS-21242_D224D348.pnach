// Near the player (flat cap): lui at,cap / sw at,0xA44(s0) in the branch delay slot.
patch=1,EE,0029ABE0,word,3C0142D6
patch=1,EE,0029ABE8,word,AE010A44
// Catch-up: the brain update's call to the target-speed function (00298FEC) goes through a wrapper at
// 000FFA00. When this opponent is more than 25 m behind the player (track progress), boost =
// min(0.36 x (gap - 25), 27) m/s: its target speed becomes at least the player's speed + boost, and
// its top speed (car+0x1354, mph) is set to stock + boost. Otherwise top speed is reset to stock.
// When it is more than 80 m AHEAD of the player, its target speed is held to 0.95 x the player's speed
// (but at least 45 m/s), so a leader can be caught.
