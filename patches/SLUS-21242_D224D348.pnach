// Speed cap ceiling 88 -> 115 m/s (257 mph), loaded as a constant instead of tuning value 01C913F4.
// Far from the player (two copies): lui at,cap / mtc1 at,f3 / min speed via lwc1 f1,0x13F8(v0) / clamp.
patch=1,EE,0029A190,word,3C0142E6
patch=1,EE,0029A198,word,44811800
