// Aggression: the game's own attack settings (AI/Aggressive Driving in its tuning data) and the AI's
// slam and shunt forces. They're loaded from the game's data, so they're written every frame.
// Min. aggression before attacking: 0.2 -> 0.1
patch=1,EE,01C914AC,word,3DCCCCCD
// Min. time between attacks (s): 0.38 -> 0.3
patch=1,EE,01C914B0,word,3E99999A
// Max. time between attacks (s): 3 -> 2.25
patch=1,EE,01C914B4,word,40100000
// Max. distance to start an attack when ahead (m): 40 -> 50
patch=1,EE,01C914B8,word,42480000
// Max. distance to start an attack when behind (m): 70 -> 85
patch=1,EE,01C914BC,word,42AA0000
// Min. speed to consider attacking (mph): 70 -> 60
patch=1,EE,01C914C0,word,42700000
// Wait at the start before attacking (s): 3 -> 2
patch=1,EE,01C914D0,word,40000000
// Min. time to block you (s): 3 -> 3.5
patch=1,EE,01C914D8,word,40600000
// Max. time to block you (s): 8 -> 9
patch=1,EE,01C914DC,word,41100000
// Max. distance ahead to start blocking you (m): 15 -> 20
patch=1,EE,01C914E0,word,41A00000
// Max. time to get into slamming position (s): 15 -> 18
patch=1,EE,01C914E8,word,41900000
// Slam time (s): 1.5 -> 1.75
