patch=1,EE,0029A298,word,3C01C0D0
patch=1,EE,0029A154,word,3C01C060
patch=1,EE,0029A2B4,word,3C01C060
// Speed cap ceiling 88 -> 107 m/s (239 mph), loaded as a constant instead of tuning value 01C913F4.
// Far from the player (two copies): lui at,cap / mtc1 at,f3 / min speed via lwc1 f1,0x13F8(v0) / clamp.
patch=1,EE,0029A190,word,3C0142D6
patch=1,EE,0029A198,word,44811800
patch=1,EE,0029A19C,word,C44113F8
patch=1,EE,0029A1A0,word,46010028
