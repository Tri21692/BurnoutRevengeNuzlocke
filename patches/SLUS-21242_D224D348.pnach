// Near the player (flat cap): lui at,cap / sw at,0xA44(s0) in the branch delay slot.
patch=1,EE,0029ABE0,word,3C0142C8
patch=1,EE,0029ABE8,word,AE010A44
// Catch-up: the brain update's call to the target-speed function (00298FEC) goes through a wrapper at
// 000FFA00. When this opponent is more than 40 m behind the player (track progress), boost =
